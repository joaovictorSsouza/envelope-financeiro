# Copie para .env e preencha com os valores reais.
# O arquivo .env NUNCA deve ser versionado (ver .gitignore).

# URL do Web App do Google Apps Script (implantação /exec)
WEBAPP_URL=https://script.google.com/macros/s/AKfycb.../exec

# Token compartilhado validado pelo Apps Script em cada requisição
API_TOKEN=troque-por-um-token-secreto

# --- Agente (Fase 3) ------------------------------------------------------

# Provedor do modelo: "google" (padrão) ou "anthropic"
PROVEDOR=google

# Chave do provedor escolhido. Só a do provedor em uso é necessária.
#   google    -> https://aistudio.google.com/apikey (grátis, sem cartão)
#   anthropic -> https://console.anthropic.com/settings/keys
GOOGLE_API_KEY=AIza...
# ANTHROPIC_API_KEY=sk-ant-...

# Modelo. Opcional: sem ele vale o padrão do provedor
#   google    -> gemini-3.5-flash-lite
#   anthropic -> claude-sonnet-5
# O padrão do Google é o flash-lite por causa da cota do free tier: a família
# flash dá 20 requisições por dia, a flash-lite dá muito mais, e um turno com
# tool gasta 2 ou 3. O README tem a tabela medida.
# Atenção: gemini-2.5-* aparece em models.list() mas a API o recusa para
# chaves novas (404 "no longer available to new users").
# MODELO=gemini-3.5-flash-lite

# Temperatura. Opcional: sem ela vale 0 — o agente não deve inventar nada
# TEMPERATURA=0

# --- Telegram (Fase 4) ----------------------------------------------------

# Token do bot criado no BotFather
TELEGRAM_TOKEN=123456789:AA...

# Único chat autorizado a usar o bot. Qualquer outro recebe uma mensagem neutra.
TELEGRAM_CHAT_ID=123456789
